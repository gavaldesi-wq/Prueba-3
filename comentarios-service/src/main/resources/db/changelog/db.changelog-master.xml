<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="1" author="benjamin">
        <createTable tableName="comentarios">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="usuario_id" type="BIGINT"/>
            <column name="usuario_nombre" type="VARCHAR(100)"/>
            <column name="pelicula_id" type="BIGINT"/>
            <column name="pelicula_titulo" type="VARCHAR(200)"/>
            <column name="contenido" type="VARCHAR(500)"/>
            <column name="fecha_creacion" type="DATETIME"/>
        </createTable>
    </changeSet>

</databaseChangeLog>